# Copy to .env and fill in. Never commit real keys.

# --- Model provider: hf (recommended) | groq | ollama ---
MODEL_PROVIDER=hf

# HF Inference router (provider pinned for deterministic runs).
# Token needs "Read" + "Read contents of public gated repos" (for GAIA files).
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct:deepinfra

# Groq: used for the chat model when MODEL_PROVIDER=groq, and always for
# audio transcription (whisper-large-v3).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Local Ollama (only when MODEL_PROVIDER=ollama)
OLLAMA_MODEL=qwen2:7b
OLLAMA_BASE_URL=http://localhost:11434

# --- Agent / tool behaviour ---
AGENT_MAX_STEPS=6
MODEL_TIMEOUT_SECONDS=120
WEB_SEARCH_ENABLED=true
WEB_PAGE_CHAR_LIMIT=6000
WEB_SEARCH_MAX_RESULTS=5

# Runs model/attachment-provided Python on the host. Off by default.
# Enable only for the trusted GAIA benchmark.
TRUST_GAIA_PYTHON_ATTACHMENTS=false
